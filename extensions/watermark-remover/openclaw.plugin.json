{
  "id": "watermark-remover",
  "name": "Watermark Remover",
  "description": "Inspects outbound human-facing text for suspicious Unicode controls in shadow mode.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "channels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": ["discord"]
      }
    }
  }
}
